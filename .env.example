# Copier en .env (jamais commité) puis adapter selon l'environnement.
#   Local   : valeurs par défaut OK (ASPNETCORE_ENVIRONMENT est de toute façon forcé à Development par l'override)
#   Staging : ASPNETCORE_ENVIRONMENT=Staging, SMTP = Gmail perso
#   Prod    : ASPNETCORE_ENVIRONMENT=Production, vrais secrets, APP_TAG figé (ex. v1.0.0)

# Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Production

# Tag de l'image ghcr.io à tirer : latest (dernier build de main), v1.0.0, sha-abc1234...
APP_TAG=latest

# MySQL
# ATTENTION : ces mots de passe ne sont lus qu'à la PREMIÈRE création du volume creastate-mysql.
# Les changer ensuite ici ne change rien dans MySQL (il faut ALTER USER, ou supprimer le volume = perte des données).
# En prod, les générer avec : openssl rand -base64 24
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_APP_PASSWORD=change-me-app

# SMTP Gmail (validation en 2 étapes + mot de passe d'application de 16 caractères)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM_EMAIL=your-gmail-address@gmail.com
SMTP_FROM_NAME=Crealab
