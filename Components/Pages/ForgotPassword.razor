@page "/account/forgot-password"
@page "/account/reset-password"
@layout LoginLayout

@inject NavigationManager NavManager
@inject AuthService AuthService

<PageTitle>Mot de passe oublié - Crealab</PageTitle>

<div class="login-wrapper theme-industrial">
    <div class="login-card animate-fade-in">
        <div class="login-header">
            <i class="fa-solid fa-key fa-3x"></i>
            <h2>@(IsReset ? "Nouveau mot de passe" : "Mot de passe oublié")</h2>
            <p>@(IsReset ? "Choisissez un nouveau mot de passe." : "Recevez un lien de réinitialisation par email.")</p>
        </div>

        <div class="login-form">
            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="error-alert">
                    <i class="fa-solid fa-triangle-exclamation"></i> @ErrorMessage
                </div>
            }

            @if (!string.IsNullOrEmpty(SuccessMessage))
            {
                <div class="alert alert-success" style="background: var(--status-success); color: white; padding: 0.75rem; border-radius: 8px; margin-bottom: 1rem;">
                    <i class="fa-solid fa-check-circle"></i> @SuccessMessage
                </div>
            }

            @if (!Done)
            {
                @if (IsReset)
                {
                    <form @onsubmit="ResetAsync">
                        <div class="form-group">
                            <label for="password">Nouveau mot de passe</label>
                            <input type="password" id="password" class="form-control" placeholder="Min. 6 caracteres" @bind="Password" required />
                        </div>
                        <div class="form-group">
                            <label for="confirm">Confirmer le mot de passe</label>
                            <input type="password" id="confirm" class="form-control" @bind="Confirm" required />
                        </div>
                        <button type="submit" class="btn-primary" disabled="@Busy">Changer le mot de passe</button>
                    </form>
                }
                else
                {
                    <form @onsubmit="SendAsync">
                        <div class="form-group">
                            <label for="email">Email</label>
                            <input type="email" id="email" class="form-control" placeholder="prenom.nom@edu.devinci.fr" @bind="Email" required />
                        </div>
                        <button type="submit" class="btn-primary" disabled="@Busy">Envoyer le lien</button>
                    </form>
                }
            }

            <button class="btn-secondary w-75" @onclick="@(() => NavManager.NavigateTo("/"))">
                Retour à la connexion
            </button>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public int UserId { get; set; }
    [SupplyParameterFromQuery] public string? Token { get; set; }

    private bool IsReset => UserId > 0 && !string.IsNullOrEmpty(Token);
    private string Email = "", Password = "", Confirm = "";
    private string ErrorMessage = "", SuccessMessage = "";
    private bool Busy, Done;

    private async Task SendAsync()
    {
        Busy = true; ErrorMessage = "";
        try
        {
            await AuthService.SendPasswordResetAsync(Email, NavManager.BaseUri);
            // Même message que l'email existe ou non
            SuccessMessage = "Si un compte existe pour cet email, un lien de réinitialisation vient d'être envoyé.";
            Done = true;
        }
        catch (Exception)
        {
            ErrorMessage = "Envoi impossible pour le moment. Réessayez plus tard.";
        }
        Busy = false;
    }

    private async Task ResetAsync()
    {
        ErrorMessage = "";
        if (Password != Confirm) { ErrorMessage = "Les mots de passe ne correspondent pas."; return; }

        Busy = true;
        var (ok, error) = await AuthService.ResetPasswordAsync(UserId, Token!, Password);
        Busy = false;

        if (ok) { SuccessMessage = "Mot de passe modifié. Vous pouvez vous connecter."; Done = true; }
        else ErrorMessage = error ?? "Erreur.";
    }
}
