@inject AuthStateProvider AuthState
@inject NavigationManager NavManager
@implements IDisposable

<div class="logo-area">
    <i class="fa-solid fa-layer-group"></i>
    Créalab
</div>

@if (AuthState.CurrentUser != null)
{
    var m = AuthState.CurrentUser;
    var initials = $"{m.FirstName[0]}{m.LastName[0]}".ToUpper();
    var fullName = $"{m.FirstName} {m.LastName}";

    <div class="user-info" style="padding: 0.75rem 1.25rem; border-bottom: 1px solid var(--border-light);">
        <div style="display: flex; align-items: center; gap: 0.5rem;">
            <div style="width: 32px; height: 32px; border-radius: 50%; background: var(--primary-blue); color: white; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 600;">
                @initials
            </div>
            <div>
                <div style="font-weight: 600; font-size: 0.85rem; color: var(--text-main);">@fullName</div>
            </div>
        </div>
    </div>
}

<ul class="nav-links" id="public-navmenu">
    <li>
        <NavLink class="nav-item" href="public" Match="NavLinkMatch.All">
            <i class="fa-solid fa-building"></i> Présentation
        </NavLink>
    </li>
    <li>
        <NavLink class="nav-item" href="public/request">
            <i class="fa-solid fa-code-pull-request"></i> Demande
        </NavLink>
    </li>
    <li>
        <NavLink class="nav-item" href="public/my-requests">
            <i class="fa-solid fa-folder-open"></i> Mes demandes
        </NavLink>
    </li>
    <li>
        <NavLink class="nav-item bottom-zone" href="public/contact">
            <i class="fa-solid fa-address-card"></i> Contacter
        </NavLink>
    </li>
</ul>

<div style="margin-top: auto; padding: 1rem 1.25rem; border-top: 1px solid var(--border-light);">
    <a href="/account/logout" class="nav-item" style="display:block; width: 100%; background: none; border: none; cursor: pointer; text-align: left; padding: 0.6rem 0.75rem; color: var(--text-muted); border-radius: 8px; text-decoration:none;">
        <i class="fa-solid fa-right-from-bracket"></i> Déconnexion
    </a>
</div>


@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask != null)
        {
            var authState = await AuthStateTask;
            await AuthState.EnsureLoadedAsync(authState);
        }
    }

    public void Dispose() { }
}
